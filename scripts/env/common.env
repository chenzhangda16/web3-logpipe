# scripts/env/common.env

# ---------- topics / groups ----------
IN_TOPIC=mockchain.blocks
OUT_TOPIC=logpipe.out
PROC_GROUP=logpipe-processor
WRITER_GROUP=logpipe.writer

# ---------- postgres ----------
PG_DB=web3log
PG_USER=web3
PG_PASS=web3

# ---------- mockchain / fetcher / processor ----------
MOCK_ADDR=5000
MOCK_TICK=1s
MOCK_DET=false
MOCK_SEED=1
MOCK_BACKFILL_SEC=86400
MOCK_GAP_SEC=0

FETCH_BACKFILL_SEC=86400
FETCH_PAGE=200
FETCH_POLL_HEAD=2s
CKPT_TICK=1s
PERF_MODE=bench
RPC_CONCURRENCY=8

PROC_DECODE_WORKER=8
PROC_DECODE_QUEUE=8192

NO_BUILD=false