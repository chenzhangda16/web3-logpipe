# ---------- remote project roots ----------
ROOT_MAIN=$HOME/Code/go/project/web3-logpipe
ROOT_PC127=$HOME/Code/go/project/web3-logpipe
ROOT_M2=$HOME/workspace/web3-logpipe
ROOT_PIXEL=$HOME/workspace/web3-logpipe

# ---------- service mapping ----------
HOST_PROCESSOR=$HOST_MAIN
HOST_MOCKCHAIN=$HOST_PC127
HOST_FETCHER=$HOST_PC127
HOST_KAFKA=$HOST_M2
HOST_PG=$HOST_M2
HOST_WRITER=$HOST_PIXEL

# ---------- deploy dirs ----------
BIN_DIR_MAIN=$ROOT_MAIN/bin
BIN_DIR_PC127=$ROOT_PC127/bin
BIN_DIR_PIXEL=$ROOT_PIXEL/bin

LOG_DIR_MAIN=$ROOT_MAIN/logs
LOG_DIR_PC127=$ROOT_PC127/logs
LOG_DIR_PIXEL=$ROOT_PIXEL/logs


# ---------- host / ports ----------
PG_HOST=192.168.1.50
PG_PORT=55432

KAFKA_HOST=192.168.1.50
KAFKA_PORT=19092

MOCK_RPC_HOST=192.168.1.50
MOCK_RPC_PORT=18080


# ---------- proxy ----------
NO_PROXY=localhost,192.168.1.50,::1

# ---------- kafka install ----------
KAFKA_HOME=/opt/kafka_2.13-3.8.0